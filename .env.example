# Copy this file to .env for Docker development only.
# Replace placeholders locally. Never commit .env or real credentials.

# ==================================================
# APPLICATION
# ==================================================
ASPNETCORE_ENVIRONMENT=Development
APP_NAME=XAUUSD-AI
APP_VERSION=1.0.0
LOG_LEVEL_DEFAULT=Information

# ==================================================
# API AND FRONTEND (non-secret)
# ==================================================
API_PORT=YOUR_API_HOST_PORT
WEB_PORT=YOUR_WEB_HOST_PORT
NEXT_PUBLIC_API_URL=YOUR_BROWSER_API_URL
CORS_ALLOWED_ORIGINS=YOUR_WEB_ORIGIN
API_ENABLE_SWAGGER=true

# ==================================================
# SQL SERVER / DATABASE (Phase 3)
# ==================================================
SQLSERVER_PORT=YOUR_SQLSERVER_HOST_PORT
# Required local secrets. Replace these in .env with two different strong passwords.
MSSQL_SA_PASSWORD=USER_PROVIDED_LATER
DATABASE_APP_PASSWORD=USER_PROVIDED_LATER
DATABASE_ENABLED=true
# Used when launching the API outside Docker. Compose constructs a restricted app-user connection.
DATABASE_CONNECTION_STRING=USER_PROVIDED_LATER
DATABASE_COMMAND_TIMEOUT_SECONDS=30
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true

# ==================================================
# REDIS (Phase 3+)
# ==================================================
REDIS_PORT=YOUR_REDIS_HOST_PORT
REDIS_ENABLED=false
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=XauAi:
REDIS_DEFAULT_EXPIRATION_SECONDS=300

# ==================================================
# AI (Phases 11-13)
# ==================================================
AI_ENABLED=false
AI_PROVIDER=None
AI_REQUIRES_API_KEY=true
OPENAI_API_KEY=USER_PROVIDED_LATER
AI_BASE_URL=
AI_MODEL=MODEL_DEFINED_LATER
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2000
AI_DAILY_BUDGET_USD=0
AI_DAILY_REQUEST_LIMIT=0

# ==================================================
# ALLTICK MARKET DATA (recommended Docker-native provider)
# Create a free token at https://alltick.co and keep it server-side.
# AllTick's XAUUSD application symbol maps to provider code GOLD.
# ==================================================
ALLTICK_ENABLED=true
ALLTICK_TOKEN=USER_PROVIDED_LATER
ALLTICK_APPLICATION_SYMBOL=XAUUSD
ALLTICK_SYMBOL=GOLD
ALLTICK_HTTP_BASE_URL=https://quote.alltick.co/quote-b-api/
ALLTICK_WEBSOCKET_URL=wss://quote.alltick.co/quote-b-ws-api
ALLTICK_REQUEST_TIMEOUT_SECONDS=30
ALLTICK_RECONNECT_DELAY_SECONDS=10
ALLTICK_HEARTBEAT_INTERVAL_SECONDS=10
ALLTICK_QUOTE_MAX_AGE_SECONDS=30
ALLTICK_REALTIME_PERSIST_INTERVAL_SECONDS=10
ALLTICK_MAX_BARS_PER_REQUEST=500
ALLTICK_MINIMUM_HTTP_REQUEST_INTERVAL_SECONDS=10

# ==================================================
# TWELVE DATA HISTORICAL / BACKUP / REFERENCE
# Uses its own free quota independently from AllTick.
# ==================================================
TWELVE_DATA_ENABLED=true
TWELVE_DATA_API_KEY=USER_PROVIDED_LATER
TWELVE_DATA_APPLICATION_SYMBOL=XAUUSD
TWELVE_DATA_SYMBOL=XAU/USD
TWELVE_DATA_BASE_URL=https://api.twelvedata.com/
TWELVE_DATA_REQUEST_TIMEOUT_SECONDS=30
TWELVE_DATA_MINIMUM_REQUEST_INTERVAL_SECONDS=8
TWELVE_DATA_REFERENCE_SYNC_INTERVAL_SECONDS=900
TWELVE_DATA_INITIAL_HISTORY_DAYS=7
TWELVE_DATA_INCREMENTAL_LOOKBACK_MINUTES=180
TWELVE_DATA_MAXIMUM_POINTS_PER_REQUEST=5000
TWELVE_DATA_MAXIMUM_CLOSE_DEVIATION_BPS=30

# ==================================================
# METATRADER 5 (optional Windows-host fallback)
# ==================================================
MT5_ENABLED=false
MT5_LOGIN=USER_PROVIDED_LATER
MT5_PASSWORD=USER_PROVIDED_LATER
MT5_SERVER=USER_PROVIDED_LATER
MT5_TERMINAL_PATH=USER_PROVIDED_LATER
MT5_APPLICATION_SYMBOL=XAUUSD
MT5_SYMBOL=XAUUSD
MT5_TIMEZONE=UTC
MT5_CONNECTION_TIMEOUT_SECONDS=30
MT5_REQUEST_TIMEOUT_SECONDS=60
MT5_RECONNECT_DELAY_SECONDS=5
MT5_MAX_BARS_PER_REQUEST=10000
MT5_PYTHON_EXECUTABLE=py
MT5_BRIDGE_SCRIPT_PATH=

# ==================================================
# MARKET DATA PIPELINE (Phase 5)
# ==================================================
MARKET_DATA_PROVIDER=AllTick
MARKET_DATA_PROVIDER_KEY=alltick
MARKET_DATA_SYNC_ENABLED=true
MARKET_DATA_SYMBOL=XAUUSD
MARKET_DATA_TIMEFRAMES=M1,M5,M15,M30,H1,H4,D1
MARKET_DATA_INITIAL_HISTORY_DAYS=7
MARKET_DATA_SYNC_INTERVAL_SECONDS=120
MARKET_DATA_BATCH_SIZE=500
MARKET_DATA_MAX_API_LIMIT=5000
MARKET_DATA_MAX_QUERY_RANGE_DAYS=366
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_RETRY_BASE_DELAY_SECONDS=2
MARKET_DATA_MAX_GAP_RESULTS=1000
MARKET_DATA_INCLUDE_FORMING_CANDLE=true

# ==================================================
# TECHNICAL ANALYSIS ENGINE (Phase 6)
# ==================================================
TECHNICAL_ANALYSIS_ENABLED=true
TECHNICAL_ANALYSIS_SYMBOL=XAUUSD
TECHNICAL_ANALYSIS_TIMEFRAMES=M1,M5,M15,M30,H1,H4,D1
TECHNICAL_ANALYSIS_HISTORY_LIMIT=1000
SMA_PERIODS=20,50,200
EMA_PERIODS=9,20,50,100,200
RSI_PERIOD=14
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9
ATR_PERIOD=14
ADX_PERIOD=14
BOLLINGER_PERIOD=20
BOLLINGER_STANDARD_DEVIATION=2
STOCHASTIC_K_PERIOD=14
STOCHASTIC_D_PERIOD=3
SWING_WINDOW=2
LEVEL_TOLERANCE_PERCENT=0.15
MINIMUM_LEVEL_TOUCHES=2
MAXIMUM_LEVEL_ZONES=8
PRICE_ACTION_LOOKBACK=20
VOLATILITY_LOOKBACK=50
VERY_LOW_VOLATILITY_RATIO=0.60
LOW_VOLATILITY_RATIO=0.80
HIGH_VOLATILITY_RATIO=1.20
VERY_HIGH_VOLATILITY_RATIO=1.50

# ==================================================
# NEWS (Phase 7)
# ==================================================
NEWS_ENABLED=false
NEWS_PROVIDER=NewsData
NEWS_REQUIRES_API_KEY=true
NEWS_API_KEY=USER_PROVIDED_LATER
NEWS_BASE_URL=https://newsdata.io/api/1/
NEWS_TIMEOUT_SECONDS=30
NEWS_MAX_RETRIES=2
NEWS_RATE_LIMIT_PER_MINUTE=0
NEWS_USE_TIMEFRAME_PARAMETER=false
NEWS_PROVIDER_KEY=newsdata
NEWS_SYMBOL=XAUUSD
NEWS_LANGUAGE=en
NEWS_PROVIDER_QUERY=gold OR bullion OR XAUUSD OR "Federal Reserve" OR FOMC OR inflation OR CPI OR NFP OR USD
NEWS_INITIAL_LOOKBACK_HOURS=24
NEWS_COLLECTION_OVERLAP_MINUTES=10
NEWS_COLLECTION_INTERVAL_SECONDS=900
NEWS_PAGE_SIZE=10
NEWS_MAXIMUM_PAGES_PER_COLLECTION=3
NEWS_MAXIMUM_PAGE_SIZE=100
NEWS_MAXIMUM_COLLECTION_RANGE_DAYS=31
NEWS_RETRY_BASE_DELAY_SECONDS=2
NEWS_ARCHIVE_ENABLED=false
NEWS_MINIMUM_RELEVANCE=Medium
NEWS_GOLD_KEYWORDS=gold,bullion,precious metal,xau,xauusd
NEWS_USD_KEYWORDS=us dollar,usd,dxy,dollar index,greenback
NEWS_FED_KEYWORDS=federal reserve,fomc,jerome powell,powell,fed chair
NEWS_INFLATION_KEYWORDS=inflation,consumer price index,cpi,personal consumption expenditures,pce
NEWS_EMPLOYMENT_KEYWORDS=nonfarm payroll,non-farm payroll,nfp,jobs report,unemployment,jobless claims
NEWS_RATES_KEYWORDS=interest rate,rate cut,rate hike,treasury yield,bond yield,real yield
NEWS_ECONOMY_KEYWORDS=us economy,gdp,economic growth,recession,retail sales,ism,consumer confidence
NEWS_CENTRAL_BANK_KEYWORDS=central bank,ecb,bank of japan,boj,bank of england,pboc
NEWS_GEOPOLITICS_KEYWORDS=geopolitical,sanctions,war,conflict,ceasefire,trade tensions,safe haven
NEWS_COMMODITY_KEYWORDS=commodity,commodities,silver,oil price,energy market

# ==================================================
# ECONOMIC DATA (Phase 8)
# ==================================================
ECONOMIC_DATA_ENABLED=false
ECONOMIC_DATA_PROVIDER=FRED
ECONOMIC_DATA_PROVIDER_KEY=fred
ECONOMIC_DATA_REQUIRES_API_KEY=true
FRED_API_KEY=USER_PROVIDED_LATER
ECONOMIC_DATA_BASE_URL=https://api.stlouisfed.org/fred/
ECONOMIC_DATA_TIMEOUT_SECONDS=30
ECONOMIC_DATA_MAX_RETRIES=2
ECONOMIC_DATA_RATE_LIMIT_PER_MINUTE=100
ECONOMIC_DATA_INITIAL_HISTORY_YEARS=20
ECONOMIC_DATA_REVISION_LOOKBACK_DAYS=370
ECONOMIC_DATA_SYNC_INTERVAL_MINUTES=360
ECONOMIC_DATA_PROVIDER_PAGE_SIZE=1000
ECONOMIC_DATA_MAXIMUM_PAGES_PER_SERIES=100
ECONOMIC_DATA_MAXIMUM_PAGE_SIZE=500
ECONOMIC_DATA_MAXIMUM_QUERY_RANGE_YEARS=100
ECONOMIC_DATA_RETRY_BASE_DELAY_SECONDS=2
ECONOMIC_DATA_TRACKED_SERIES=CPIAUCSL:Inflation,CPILFESL:Inflation,PCEPI:Inflation,PCEPILFE:Inflation,UNRATE:Employment,PAYEMS:Employment,FEDFUNDS:InterestRates,DGS2:Treasury,DGS5:Treasury,DGS10:Treasury,DGS30:Treasury,GDP:EconomicGrowth,GDPC1:EconomicGrowth,RSAFS:Consumer,INDPRO:Production,UMCSENT:Consumer

# ==================================================
# ANALYST SOURCES (Phase 9)
# Source types: OfficialApi, RssFeed, PublicSource, PermittedWeb, Manual
# ==================================================
ANALYSTS_ENABLED=false
ANALYST_PROVIDER=None
ANALYST_SOURCE_TYPE=Manual
ANALYST_REQUIRES_API_KEY=false
ANALYST_PROVIDER_API_KEY=USER_PROVIDED_LATER
ANALYST_BASE_URL=
ANALYST_TIMEOUT_SECONDS=30
ANALYST_MAX_RETRIES=2
ANALYST_RATE_LIMIT_PER_MINUTE=0
