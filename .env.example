# EVIDENCE AND AI INTERPRETATION
# ====================================================================================

EVIDENCE_MAXIMUM_PAGE_SIZE=200
EVIDENCE_MAXIMUM_QUERY_RANGE_DAYS=365
EVIDENCE_DEFAULT_PACK_LOOKBACK_DAYS=30
EVIDENCE_MAXIMUM_PACK_LOOKBACK_DAYS=730
